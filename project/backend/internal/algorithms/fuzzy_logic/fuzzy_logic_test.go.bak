func TestDefuzzifier_EmptySet(t *testing.T) {
	defuzz := NewDefuzzifier(CentroidMethod, 100)

	// Empty fuzzy set
	emptySet := &FuzzySet{Universe: []float64{}, Membership: []float64{}}
	result := defuzz.Defuzzify(emptySet)

	if result != 0.0 {
		t.Errorf("Empty set should return 0.0, got %.3f", result)
	}

	// Zero membership set
	zeroSet := &FuzzySet{
		Universe:   []float64{0, 1, 2, 3, 4},
		Membership: []float64{0, 0, 0, 0, 0},
	}
	result2 := defuzz.Defuzzify(zeroSet)

	// Should return midpoint for zero membership
	expected := 2.0 // (0+4)/2
	if math.Abs(result2-expected) > 1e-6 {
		t.Errorf("Zero membership should return midpoint %.1f, got %.3f", expected, result2)
	}
}
