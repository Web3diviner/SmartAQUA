// Test Membership Functions
func TestTriangularMF_Evaluate(t *testing.T) {
	mf := NewTriangularMF("test", 0, 5, 10)

	tests := []struct {
		input    float64
		expected float64
	}{
		{-1, 0.0},  // Before start
		{0, 0.0},   // At start
		{2.5, 0.5}, // Rising edge
		{5, 1.0},   // Peak
		{7.5, 0.5}, // Falling edge
		{10, 0.0},  // At end
		{11, 0.0},  // After end
	}

	for _, test := range tests {
		result := mf.Evaluate(test.input)
		if math.Abs(result-test.expected) > 1e-6 {
			t.Errorf("TriangularMF.Evaluate(%.1f) = %.3f, expected %.3f",
				test.input, result, test.expected)
		}
	}
}

func TestTrapezoidalMF_Evaluate(t *testing.T) {
	mf := NewTrapezoidalMF("test", 0, 2, 8, 10)

	tests := []struct {
		input    float64
		expected float64
	}{
		{-1, 0.0}, // Before start
		{0, 0.0},  // At start
		{1, 0.5},  // Rising edge
		{2, 1.0},  // Flat top start
		{5, 1.0},  // Flat top middle
		{8, 1.0},  // Flat top end
		{9, 0.5},  // Falling edge
		{10, 0.0}, // At end
		{11, 0.0}, // After end
	}

	for _, test := range tests {
		result := mf.Evaluate(test.input)
		if math.Abs(result-test.expected) > 1e-6 {
			t.Errorf("TrapezoidalMF.Evaluate(%.1f) = %.3f, expected %.3f",
				test.input, result, test.expected)
		}
	}
}

func TestGaussianMF_Evaluate(t *testing.T) {
	mf := NewGaussianMF("test", 5, 1)

	// Test peak
	result := mf.Evaluate(5)
	if math.Abs(result-1.0) > 1e-6 {
		t.Errorf("Gaussian peak should be 1.0, got %.6f", result)
	}

	// Test symmetry
	result1 := mf.Evaluate(4)
	result2 := mf.Evaluate(6)
	if math.Abs(result1-result2) > 1e-6 {
		t.Errorf("Gaussian should be symmetric: f(4)=%.6f, f(6)=%.6f", result1, result2)
	}

	// Test range
	if result1 <= 0 || result1 >= 1 {
		t.Errorf("Gaussian values should be in (0,1), got %.6f", result1)
	}
}

func TestSigmoidMF_Evaluate(t *testing.T) {
	mf := NewSigmoidMF("test", 1, 5)

	// Test center point
	result := mf.Evaluate(5)
	if math.Abs(result-0.5) > 1e-6 {
		t.Errorf("Sigmoid at center should be 0.5, got %.6f", result)
	}

	// Test monotonicity
	result1 := mf.Evaluate(0)
	result2 := mf.Evaluate(10)
	if result1 >= result2 {
		t.Errorf("Sigmoid should be monotonic: f(0)=%.6f should be < f(10)=%.6f", result1, result2)
	}
}

// Test Linguistic Variables
func TestLinguisticVariable_Operations(t *testing.T) {
	lv := NewLinguisticVariable("temperature", 0, 40, "Water temperature")

	// Add terms
	lv.AddTerm("cold", NewTriangularMF("cold", 0, 10, 20))
	lv.AddTerm("warm", NewTriangularMF("warm", 15, 25, 35))
	lv.AddTerm("hot", NewTriangularMF("hot", 30, 35, 40))

	// Test membership calculation
	membership := lv.GetMembership(15, "cold")
	expected := 0.5 // At 15, cold membership should be 0.5
	if math.Abs(membership-expected) > 1e-6 {
		t.Errorf("GetMembership(15, 'cold') = %.3f, expected %.3f", membership, expected)
	}

	// Test all memberships
	allMemberships := lv.GetAllMemberships(25)
	if len(allMemberships) != 3 {
		t.Errorf("Expected 3 memberships, got %d", len(allMemberships))
	}

	// Test terms retrieval
	terms := lv.GetTerms()
	if len(terms) != 3 {
		t.Errorf("Expected 3 terms, got %d", len(terms))
	}
}

func TestLinguisticSetManager_Operations(t *testing.T) {
	lsm := NewLinguisticSetManager()

	// Initialize feeding control sets
	lsm.InitializeFeedingControlSets()

	// Test variable retrieval
	tempVar, err := lsm.GetVariable("temperature")
	if err != nil {
		t.Errorf("Failed to get temperature variable: %v", err)
	}
	if tempVar == nil {
		t.Error("Temperature variable should not be nil")
	}

	// Test membership calculation
	membership, err := lsm.GetMembership("temperature", 25, "optimal")
	if err != nil {
		t.Errorf("Failed to get membership: %v", err)
	}
	if membership < 0 || membership > 1 {
		t.Errorf("Membership %.3f should be between 0 and 1", membership)
	}

	// Test value validation
	err = lsm.ValidateValue("temperature", 25)
	if err != nil {
		t.Errorf("Value 25 should be valid for temperature: %v", err)
	}

	err = lsm.ValidateValue("temperature", 50)
	if err == nil {
		t.Error("Value 50 should be invalid for temperature")
	}

	// Test dominant term
	term, membership, err := lsm.GetDominantTerm("temperature", 25)
	if err != nil {
		t.Errorf("Failed to get dominant term: %v", err)
	}
	if term == "" {
		t.Error("Dominant term should not be empty")
	}
	if membership <= 0 {
		t.Errorf("Dominant membership %.3f should be positive", membership)
	}
}

// Test Defuzzification
func TestDefuzzifier_CentroidMethod(t *testing.T) {
	defuzz := NewDefuzzifier(CentroidMethod, 100)

	// Create simple triangular fuzzy set
	universe := []float64{0, 1, 2, 3, 4, 5}
	membership := []float64{0, 0.5, 1, 0.5, 0, 0}
	fuzzySet := &FuzzySet{Universe: universe, Membership: membership}

	result := defuzz.Defuzzify(fuzzySet)

	// For symmetric triangle, centroid should be at peak
	expected := 2.0
	if math.Abs(result-expected) > 0.1 {
		t.Errorf("Centroid defuzzification = %.3f, expected %.3f", result, expected)
	}
}

func TestDefuzzifier_MeanOfMaxima(t *testing.T) {
	defuzz := NewDefuzzifier(MeanOfMaximaMethod, 100)

	// Create fuzzy set with two peaks
	universe := []float64{0, 1, 2, 3, 4, 5, 6}
	membership := []float64{0, 1, 0, 0, 1, 0, 0}
	fuzzySet := &FuzzySet{Universe: universe, Membership: membership}

	result := defuzz.Defuzzify(fuzzySet)

	// Mean of maxima at positions 1 and 4 should be 2.5
	expected := 2.5
	if math.Abs(result-expected) > 1e-6 {
		t.Errorf("Mean of maxima = %.3f, expected %.3f", result, expected)
	}
}

func TestDefuzzifier_AllMethods(t *testing.T) {
	methods := GetSupportedMethods()

	universe := []float64{0, 1, 2, 3, 4}
	membership := []float64{0, 0.5, 1, 0.5, 0}
	fuzzySet := &FuzzySet{Universe: universe, Membership: membership}

	for _, method := range methods {
		if !ValidateMethod(method) {
			t.Errorf("Method %s should be valid", method)
		}

		defuzz := NewDefuzzifier(method, 100)
		result := defuzz.Defuzzify(fuzzySet)

		// All methods should return reasonable values
		if result < 0 || result > 4 {
			t.Errorf("Method %s returned unreasonable result: %.3f", method, result)
		}
	}
}

// Test Rule Engine
func TestRuleEngine_BasicOperations(t *testing.T) {
	lsm := NewLinguisticSetManager()
	lsm.InitializeFeedingControlSets()

	engine := NewRuleEngine(lsm, "mamdani")
	engine.InitializeFeedingRules()

	// Test rule count
	count := engine.GetRuleCount()
	if count == 0 {
		t.Error("Rule engine should have rules after initialization")
	}

	// Test rule retrieval
	rule, err := engine.GetRule(1)
	if err != nil {
		t.Errorf("Failed to get rule 1: %v", err)
	}
	if rule == nil {
		t.Error("Rule 1 should not be nil")
	}

	// Test invalid rule
	_, err = engine.GetRule(999)
	if err == nil {
		t.Error("Should get error for non-existent rule")
	}
}

func TestRuleEngine_Evaluation(t *testing.T) {
	lsm := NewLinguisticSetManager()
	lsm.InitializeFeedingControlSets()

	engine := NewRuleEngine(lsm, "mamdani")
	engine.InitializeFeedingRules()

	// Test inputs
	inputs := map[string]float64{
		"temperature":        25.0, // optimal
		"dissolved_oxygen":   8.0,  // good
		"ph":                 7.2,  // neutral
		"fish_activity":      75.0, // high
		"time_since_feeding": 6.0,  // medium
		"feeding_demand":     60.0, // high
	}

	// Evaluate rules
	outputs, err := engine.EvaluateRules(inputs)
	if err != nil {
		t.Errorf("Failed to evaluate rules: %v", err)
	}

	// Check outputs
	if len(outputs) == 0 {
		t.Error("Should have output values")
	}

	for variable, value := range outputs {
		if math.IsNaN(value) || math.IsInf(value, 0) {
			t.Errorf("Output %s has invalid value: %.3f", variable, value)
		}
	}
}

