# AquaDoc service configuration.
# Copy to .env and fill in real values. NEVER commit .env.
# Real secrets must never appear in this file (07_SECURITY_ARCHITECTURE.md section 4).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# Comma-separated origins allowed to call the dev API (the temporary web frontend).
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aquadoc:aquadoc@localhost:5432/aquadoc

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Shared secret the Go backend presents on /internal/v1/* calls.
AQUADOC_INTERNAL_SERVICE_SECRET=

# Dev-only bearer token for /dev/v1/* routes. Ignored unless APP_ENV=development.
# The service refuses to start if this is set while APP_ENV=production.
AQUADOC_DEV_TOKEN=

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# claude | echo   (echo is a deterministic offline provider for tests/local dev)
LLM_PROVIDER=echo
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=8000
LLM_EFFORT=high
LLM_TIMEOUT_SECONDS=120
# Route safety refusals to a fallback model inside the same call.
LLM_ENABLE_REFUSAL_FALLBACK=true
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
# hashing | voyage   (hashing is deterministic and offline; not for production quality)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
VOYAGE_MODEL=voyage-3
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.15
RETRIEVAL_ENABLE_LEXICAL=true

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
CHUNK_TARGET_TOKENS=750
CHUNK_OVERLAP_TOKENS=150
MAX_UPLOAD_BYTES=26214400
