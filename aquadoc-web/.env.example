# AquaDoc web frontend configuration.
# Copy to .env. Vite exposes every VITE_* variable to the browser bundle.
#
# NEVER put a real secret here. 15_AQUADOC_FRONTEND.md section 6:
# LLM_API_KEY, EMBEDDING_API_KEY, DATABASE_PASSWORD, MQTT_ADMIN_PASSWORD and
# AQUADOC_INTERNAL_SERVICE_SECRET must never appear in frontend environment
# variables — browser environment variables are public to the browser.

VITE_AQUADOC_API_URL=http://localhost:8001
VITE_APP_ENV=development
VITE_ENABLE_DEBUG_PANEL=true

# Development-only bearer token, matching AQUADOC_DEV_TOKEN on the service.
# This is a local development credential, not a production secret. AquaDoc
# refuses to start in production with a dev token configured.
VITE_AQUADOC_DEV_TOKEN=
